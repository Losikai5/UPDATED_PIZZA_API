# Frontend build-time config. Copy to .env.local for dev, or set in your
# static host's build settings (Netlify/Vercel/Render) for production.
# Must include the /api/v2 path; the backend mounts every router under it.

# Local dev (default if unset):
# VITE_API_URL=http://localhost:8000/api/v2

# Production example:
VITE_API_URL=https://pizza-api.onrender.com/api/v2
